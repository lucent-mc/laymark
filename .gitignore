# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
# `build/` above also matches a *package* named build, which is where the Gradle plugin task
# lives. The leading `**/` is load-bearing: a pattern containing a slash anchors at the repo
# root, so `!src/**/build/` never matched `build-logic/src/...` and the task went untracked.
!**/src/**/build/

# Java
*.class
hs_err_pid*
replay_pid*

# NeoForge / ModDevGradle dev runs
run/
runs/

# Benchmark output — raw samples and reports are large and machine-specific
benchmark-results/
*.jsonl
*.jsonl.gz
*.sparkprofile

# Machine-local config
*.local.jsonc
*.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ. Gradle regenerates all of it on import, and it churns on every sync --
# 136 files appeared from one Gradle import during this slice.
.idea/
*.iml
