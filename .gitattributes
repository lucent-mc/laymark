# Normalise to LF in the repository. Without this, a Windows checkout commits CRLF into
# gradlew, and the Linux CI runner fails with a bad interpreter line.
* text=auto eol=lf

# Windows-only scripts genuinely want CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Never touch these.
*.jar          binary
*.png          binary
*.zip          binary
*.schem        binary
*.nbt          binary
*.sparkprofile binary
